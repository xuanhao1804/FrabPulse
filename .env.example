# ==============================================================================
# FrabPulse Environment Configuration Template
# Copy this file to .env before starting the development environment.
# ==============================================================================

# System Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend (NestJS) API Configuration
# ------------------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
# Used by Prisma ORM in apps/api
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/frabpulse?schema=public"

# Redis Cache & Background Ingestion (Optional)
REDIS_URL="redis://localhost:6379"

# AI Intelligence Layer Configuration
# If OPENAI_API_KEY is not provided, the API automatically falls back to
# the DeterministicLabAIProvider (zero network calls, reproducible mock AI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Market Data Mode: 'MOCK' or 'HYBRID_LIVE'
# 'MOCK' uses deterministic realistic snapshots with live volatility simulations.
MARKET_DATA_MODE=MOCK

# ------------------------------------------------------------------------------
# Frontend (Next.js) Web Configuration
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME="FrabPulse"
NEXT_PUBLIC_IS_DEMO_DEFAULT=true
